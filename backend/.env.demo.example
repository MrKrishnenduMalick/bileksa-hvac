# PUBLIC DEMO API. Use a SEPARATE Supabase project from paying clients (that is the isolation).
# On Render these are set in the dashboard (see render.yaml); never commit real values.
ENVIRONMENT=production
DEMO_MODE=true
REQUIRE_ADMIN_MFA=false
DATABASE_URL=postgresql+asyncpg://postgres.DEMOREF:PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres
PUBLIC_API_URL=https://bileksa-demo-api.onrender.com
FRONTEND_URL=https://demo.your-domain.com
CORS_ORIGINS=https://demo.your-domain.com
SUPABASE_URL=https://DEMOREF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
INTERNAL_SWEEP_SECRET=

# Demo sign-ins: published on /demo on purpose. Long random values, used nowhere else.
DEMO_OWNER_EMAIL=owner@houstoncomfort.example
DEMO_OWNER_PASSWORD=
DEMO_ADMIN_EMAIL=admin@bileksa-demo.example
DEMO_ADMIN_PASSWORD=

# Vapi (a Vapi account WITHOUT a card on file: spending stops when the free credits do)
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_TOOL_IDS=
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1-mini

# Voice spending guard. The public admin screen can only lower the budget below the cap.
DEMO_LIVE_VOICE=true
DEMO_VOICE_BUDGET_CAP_USD=5
DEMO_VOICE_MAX_CALL_SECONDS=180
DEMO_VOICE_MAX_CALLS_PER_DAY=25
DEMO_VOICE_CALLS_PER_IP_PER_HOUR=3
DEMO_MAX_CLIENTS=12
