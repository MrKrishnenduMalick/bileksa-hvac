# Copy to .env for local development. Never commit real values.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
PUBLIC_API_URL=https://api.your-domain.com
FRONTEND_URL=https://app.your-domain.com
CORS_ORIGINS=https://app.your-domain.com

# Supabase Auth: set SUPABASE_URL (asymmetric signing keys / JWKS) or SUPABASE_JWT_SECRET (legacy HS256)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=
# Publishable anon key: used by the backend only to re-verify admin passwords
SUPABASE_ANON_KEY=
# Backend-only secret: used to invite client owners. Never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Vapi
VAPI_PRIVATE_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_CREDENTIAL_ID=
VAPI_TOOL_IDS=
VAPI_PHONE_AREA_CODE=713

# Master template (decision D9: confirm by listening tests)
VOICE_PROVIDER=11labs
VOICE_ID=sarah
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1
TRANSCRIBER_PROVIDER=deepgram
TRANSCRIBER_MODEL=nova-3

# Recovery sweep (Supabase pg_cron calls POST /internal/sweep with this bearer token)
INTERNAL_SWEEP_SECRET=

# Email notifications (optional; notifications always appear in the dashboards)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
ADMIN_NOTIFICATION_EMAIL=

# Optional: import client numbers bought in BILEKSA's own Twilio account into Vapi
# (cheaper than Vapi numbers at volume). Backend-only secrets.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Never enable on the client deployment: DEMO_MODE=true turns this API into the public demo.
DEMO_MODE=false
